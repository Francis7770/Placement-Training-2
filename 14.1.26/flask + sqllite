from flask import Flask, request, jsonify
import sqlite3

app = Flask(__name__)

def get_db():
    conn = sqlite3.connect("data.db")
    return conn

@app.route("/add", methods=["POST"])
def add():
    data = request.json
    conn = get_db()
    conn.execute("INSERT INTO users (name, age) VALUES (?, ?)", (data["name"], data["age"]))
    conn.commit()
    return jsonify({"status": "success"})
