import java.util.*;

class Solution {
    public boolean closeStrings(String word1, String word2) {
        
        // Step 1: Length check
        if (word1.length() != word2.length()) {
            return false;
        }

        // Frequency arrays
        int[] freq1 = new int[26];
        int[] freq2 = new int[26];

        // Bitmasks for character presence
        int present1 = 0;
        int present2 = 0;

        // Step 2: Count frequency & track presence
        for (int i = 0; i < word1.length(); i++) {
            char c1 = word1.charAt(i);
            char c2 = word2.charAt(i);

            freq1[c1 - 'a']++;
            freq2[c2 - 'a']++;

            present1 |= (1 << (c1 - 'a'));
            present2 |= (1 << (c2 - 'a'));
        }

        // Step 3: Unique character set check
        if (present1 != present2) {
            return false;
        }

        // Step 4: Compare frequency distributions
        Arrays.sort(freq1);
        Arrays.sort(freq2);

        return Arrays.equals(freq1, freq2);
    }
}
